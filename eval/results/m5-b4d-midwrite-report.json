  "write_state_model": {
    "runtime": "eval/harness/write_state.py",
    "states": [
      "not_started",
      "partially_applied",
      "committed",
      "rolled_back"
    ],
    "terminal": [
      "committed"
    ],
    "transitions": {
      "not_started": [
        "committed",
        "partially_applied"
      ],
      "partially_applied": [
        "committed",
        "rolled_back"
      ],
      "rolled_back": [
        "committed",
        "not_started"
      ],
      "committed": []
    },
    "parts": "the record itself, then one part per derived copy the backup holds for it (index, cache, summary)",
    "policies": {
      "resume": "the retry keeps the parts already written and applies only the missing ones",
      "rollback": "the retry removes the record from every copy, then rewrites it from the start"
    },
    "observability": "mid-write points are only offered on records the live store lost; a record that is still present is refused at load time because rewriting a copy that is already there is idempotent",
    "gold": "the fixture declares the interrupted and rolled-back record counts and the loader recomputes them from the schedule and the policy, refusing the fixture when they disagree",
    "schedule": {
      "states": [
        "not_started",
        "partially_applied",
        "committed",
        "rolled_back"
      ],
      "terminal": [
        "committed"
      ],
      "transitions": {
        "not_started": [
          "partially_applied",
          "committed"
        ],
        "partially_applied": [
          "committed",
          "rolled_back"
        ],
        "rolled_back": [
          "not_started"
        ],
        "committed": []
      },
      "parts": "one per copy the backup holds for the record: the record itself, then its index, cache and summary entries in that order",
      "policies": {
        "resume": "the retry keeps the copies already written and applies only the missing ones",
        "rollback": "the retry removes the record from every copy, then rewrites it from the start"
      },
      "observability": "an interruption is only observable on a record the live store has lost: rewriting a copy that is already there is idempotent, so a mid-write schedule may not name a record that is still present",
      "gold": "the fixture declares the interrupted and rolled-back record counts; the loader recomputes them from the schedule and the policy and refuses the fixture if the two disagree"
    }
  },
  "fault_schedule": {
    "between_records": {
      "rule": "stop = int(sha256(f'{task}:{salt}:{attempt}')[:8], 16) % len(candidates), over records of the backup",
      "solver_view": "the candidate bounds only; the solver learns of the interruption when the harness refuses the next record"
    },
    "inside_a_write": {
      "rule": "one point per (record, copy boundary) for records the live store lost, in backup order; the fixture declares which of those points are candidates and the harness derives the chosen one from the same deterministic function",
      "solver_view": "the recovery policy only (resume or rollback, because that is the rule it must follow); no candidate list, no chosen boundary, no per-record state table and no gold write states"
    },
    "gold_independence": "the expected attempt count, the per-attempt completeness flags, the per-record end state and the final store are identical for every legal candidate; the tests re-solve each mid-write task at every candidate and assert the outcome does not move"
  },
  "corruption": {
    "digest": "sha256 over the declared backup document",
    "classes": [
      "missing_entry (repaired from the live store)",
      "altered_record_id (refused before any write)",
      "invalid_metadata (refused before any write)"
    ],
    "note": "damage is classified from the data itself, never from a hint, and damage is excluded from the partial-write and rollback counters so the corruption gate stays separately identifiable"
  },
  "phases": {
    "live_store_after_deletion": {
      "measured_by": [
        "residual_copies",
        "post_delete_hits",
        "overdeleted"
      ],
      "meaning": "the store one deletion cycle later; a copy that is still here was never removed, so it is residue, not a resurrection"
    },
    "replay_window": {
      "measured_by": [
        "resurrections"
      ],
      "meaning": "any deleted record present on a replay day but absent at the end of the deletion cycle; measured against that post-deletion state"
    },
    "restore_attempts": {
      "measured_by": [
        "restore_resurrections",
        "restore_dropped",
        "restore_residue",
        "restore_attempt_mismatch"
      ],
      "meaning": "a backup taken before the deletion is restored on a declared replay day in one or more attempts. Each attempt is audited on its own: resurrection counts only records an attempt brought back that were absent immediately before it, residue only copies an attempt itself added. An interrupted first attempt is incomplete by design and is not a failure while a retry can still finish the restore; the reported attempt sequence must match the declared one"
    },
    "final_recovered_state": {
      "measured_by": [
        "restore_unrecovered",
        "restore_duplicate_effects"
      ],
      "meaning": "after the last attempt: every surviving record the backup holds must be back, recovery probes over the final store must resolve as declared, and no derived entry may be duplicated by a retry. This is where an abandoned partial restore fails, and where a retry that re-applies its effects fails even though every record it touched is present"
    },
    "backup_integrity": {
      "measured_by": [
        "restore_corrupt_accepted"
      ],
      "meaning": "before any attempt: the backup's contents must hash to the digest it declares. Damage is classified from the data itself -- incomplete record metadata or an entry naming a record the backup does not hold must be refused before a write, a single missing derived copy may be rebuilt from a copy the store or the snapshot still holds. A damaged backup is never scored as an ordinary incomplete restore"
    },
    "record_write": {
      "measured_by": [
        "restore_partial_residue",
        "restore_rollback_errors",
        "restore_duplicate_effects"
      ],
      "meaning": "inside a restore attempt: every record a write touched is in one of the four states, a partially applied record is counted once against the record, a claimed rollback is checked against the copies still in the store, and the retry must not re-apply a part it already wrote"
    },
    "note": "the live-store, replay, restore-attempt and final-state phases are unchanged from the 22-task suite; the record-write phase is added, not folded into an existing one"
  },
