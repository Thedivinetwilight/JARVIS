  "criterion": {
    "id": "C-02-AC3",
    "text": "Deleting a record removes it and its derived copies from indexes, caches and summaries within one cycle, with zero resurrections across three drills and a seven-day replay.",
    "threshold": "0 wal-integrity errors, 0 lost committed records, 0 applied uncommitted writes, 0 duplicate effects, 0 resurrections, 0 lost unrelated records and 0 unresolved recoveries on the final store",
    "status": "slice_built",
    "note": "unchanged by this slice: the criterion is exercised by an evaluator slice, not met by a product, and this slice tests evaluator infrastructure rather than any J.A.R.V.I.S. storage"
  },
