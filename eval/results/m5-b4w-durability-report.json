  },
  "environment": {
    "what_it_is": "evaluator test infrastructure: a file-backed store with an explicit write-ahead log, one temporary directory per task, invented records",
    "what_it_is_not": "a production database, a storage engine, a storage product or a recommendation of one; J.A.R.V.I.S. has no product store yet, and nothing here selects or evaluates one",
    "isolation": "each driver creates its own directory under the system temp dir with the 'jarvis-b4w-' prefix, refuses a symlinked root, refuses to remove a directory it did not create, and deletes it when the task ends; the tests assert no directory survives a run and that a marker file outside it is untouched",
    "process_death": "the harness raises at a byte offset it chose; there is no kernel, no disk cache, no power loss and no fsync semantics beyond flushing the file object the harness opened"
  },
  "state_model": {
    "record_states": [
      "not_started",
      "partially_applied",
      "committed",
      "rolled_back"
    ],
    "rule": "a record is committed when its entry frame and its commit frame are both verifiable on disk; a torn or corrupt frame leaves it not_started; a record line with no commit is partially_applied residue and is removed by recovery; a committed deletion rolls the record back and is final",
    "recoverable": [
      "torn tail",
      "corrupt tail",
      "record line with no commit marker",
      "repeated transaction",
      "crash during recovery"
    ],
    "fail_closed": [
      "damage before verifiable frames",
      "commit frame without its entry",
      "unknown entry kind",
      "log without the WAL header"
    ],
    "what_recovery_does": {
      "torn_or_corrupt_tail": "cut back to the last verifiable frame, fsync the shorter file, then rebuild: the bytes after the damage are dropped and nothing that followed them is trusted",
      "damage_before_verifiable_frames": "the replay stops at the damage; frames written after it are refused even though their checksums verify (b4w-008)",
      "missing_header": "refused outright, reported as unrecovered, and never rebuilt into a plausible state",
      "commit_without_entry": "refused by sequence validation before a run",
      "unknown_entry_kind": "refused by sequence validation before a run"
    }
  },
  "crash_schedule": {
