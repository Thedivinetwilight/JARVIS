    "spec": "1.1.0",
    "derived_from": [
      {
        "criterion": "C-02-AC1",
        "metric": "100% of writes carry the five metadata fields; the store rejects writes missing any field",
        "slice": "6 metadata tasks, one rejection each, including an empty permitted_uses list"
      },
      {
        "criterion": "C-02-AC2",
        "metric": ">=95% of facts with an expiry policy are excluded from or labelled 'stale' at query time",
        "slice": "6 expiry tasks: excluded, labelled, and mid-scenario expiry"
      },
      {
        "criterion": "C-01-AC2",
        "metric": "100% of stored preferences expose source, observed_at and confidence",
        "slice": "partial only: source and observed_at are required by every write; confidence and deletion are not exercised"
      }
    ],
    "task_counts": {
      "total": 12,
      "metadata_enforcement": 6,
      "expiry": 6,
