# Copy to .env. Never commit real credentials. See docs/CONFIGURATION.md.
JARVIS_HOME=~/.jarvis
JARVIS_WORKSPACE=.
JARVIS_PRINCIPAL_NAME=Sivaram

# Models are optional. Remote endpoints additionally require JARVIS_NETWORK_ENABLED=true.
JARVIS_PROVIDER=auto
JARVIS_PROVIDER_TIMEOUT=30
JARVIS_NETWORK_ENABLED=false
JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-2.5-flash
# Local OpenAI-compatible server (e.g. Ollama): http://127.0.0.1:11434/v1
JARVIS_OPENAI_BASE_URL=
JARVIS_OPENAI_MODEL=
JARVIS_OPENAI_API_KEY=

# Behaviour and privacy
JARVIS_AUTONOMY_LEVEL=2
JARVIS_ALLOW_SENSITIVE_TO_PROVIDER=false
JARVIS_AFFECT_RETENTION_DAYS=30
JARVIS_SESSION_IDLE_MINUTES=30

# Local API (loopback only)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=INFO
